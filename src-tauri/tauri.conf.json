{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghbdtn",
  "version": "../package.json",
  "identifier": "com.stillmvd.ghbdtn",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "target/release/ghbdtn_layout.dll": "ghbdtn_layout.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "template": "../node_modules/@stillmvd/tauri-ship/nsis/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NENBODBBMjMxMUE4NTAKUldSUXFCRWpDcWhNWmNodHArQzEzMjV1VXNXWlp4eVRmRERyVmV4VTYwVTM5TW9FUmpYZHE4YU0K",
      "endpoints": [
        "https://github.com/stillmvd/ghbdtn/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
