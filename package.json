{
  "name": "ghbdtn",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm layoutdll && vite",
    "build": "pnpm layoutdll && tsc && vite build",
    "layoutdll": "cargo build --release --manifest-path src-tauri/Cargo.toml -p ghbdtn-layout",
    "tauri": "tauri",
    "live": "cargo run --release --manifest-path src-tauri/Cargo.toml -p ghbdtn-core --example live",
    "check": "tsc --noEmit && pnpm layoutdll && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "release": "ship release",
    "ship": "ship"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "kockers-ds": "link:..\\..\\Kockers DS",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@stillmvd/tauri-ship": "github:stillmvd/tauri-ship#v0.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
